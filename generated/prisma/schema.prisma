generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                     Int       @id @default(autoincrement())
  firstName              String
  lastName               String
  email                  String    @unique
  phoneNo                String
  password               String
  otp                    String?
  otpExpiry              DateTime?
  isVerified             Boolean   @default(false)
  passwordResetOTP       String?
  passwordResetOTPExpiry DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  events                 Event[]
}

model Event {
  id              Int              @id @default(autoincrement())
  title           String
  description     String
  startDate       DateTime
  deadline        DateTime
  createdById     Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       Admin            @relation(fields: [createdById], references: [id])
  participants    Participant[]
  picks           Pick[]
  specialRequests SpecialRequest[]
}

model Participant {
  id        Int      @id @default(autoincrement())
  name      String
  isPicked  Boolean  @default(false)
  eventId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  picks     Pick[]
}

model Pick {
  id                  Int         @id @default(autoincrement())
  eventId             Int
  pickerName          String
  pickedParticipantId Int
  pickedName          String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  event               Event       @relation(fields: [eventId], references: [id])
  pickedParticipant   Participant @relation(fields: [pickedParticipantId], references: [id])
}

model SpecialRequest {
  id          Int      @id @default(autoincrement())
  eventId     Int
  name        String
  emailAdd    String
  phone       String
  wantToGift  String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id])
}
